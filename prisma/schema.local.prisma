// LOCAL DEV/TEST SCHEMA (SQLite mirror of schema.prisma).
// KEEP IN SYNC: any model change must be made in BOTH files.
// NOTE: Both schemas MUST stay in sync — any model addition/removal/field change
// must be mirrored in both files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Cooperatives (multi-tenant orgs) ----
model Cooperative {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique // e.g. TEST01 — used to join via WhatsApp
  description        String?
  state              String? // Nigerian state (or country for global scope)
  country            String              @default("NG")
  currency           String              @default("NGN")
  adminPhone         String? // WhatsApp number of the coop super admin
  status             String              @default("active") // active | suspended
  loanInterestRate   Float               @default(2) // fallback monthly % charged on loans (percentage)
  dailyPayoutLimit   Int                 @default(100000000) // fraud guard: max total money-out per day in kobo (₦1M)
  reserveFundBalance Int                 @default(0) // statutory reserve fund balance in kobo
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  members            Member[]
  contributions      Contribution[]
  loans              Loan[]
  payouts            Payout[]
  units              Unit[]
  dividends          Dividend[]
  broadcasts         Broadcast[]
  withdrawalRequests WithdrawalRequest[]
  deathClaims        DeathClaim[]
  supportTickets     SupportTicket[]
  votes              Vote[]
  ledgerEntries      LedgerEntry[]
  journalEntries     JournalEntry[]
  beneficiaries      Beneficiary[]
  coopPosts         CoopPost[]
  deductionBatches  DeductionBatch[]
  externalPayments   ExternalPayment[]
  purchasePolls      PurchasePoll[]
  reconciliationLogs ReconciliationLog[]
  reserveAllocations   ReserveAllocation[]
  educationFunds      EducationFund[]
  developmentFunds    DevelopmentFund[]
  statusPosts         StatusPost[]
  payeRecords          PAYERecord[]
  byelaws              Byelaw[]
  strs                 STR[]
  grievances           Grievance[]
  config             CooperativeConfig?
  branding            BrandingConfig?
  subscription       Subscription?
  dividendVotes       DividendVote[]

  @@index([status])
  @@index([code])
}

// ---- Wallet-bank reconciliation logs ----
model ReconciliationLog {
  id                  String   @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id])
  totalWalletBalances Int      // sum of all member wallet balances in kobo
  bankBalance         Int      // cooperative's bank balance from journal in kobo
  discrepancy         Int      // difference (bankBalance - totalWalletBalances) in kobo
  status              String   // ok | discrepancy | investigating
  notes               String?
  performedBy         String   // admin phone
  memberCount         Int      // number of members in the cooperative
  activeLoans         Int      // count of active loans
  activeLoanTotal     Int      // total disbursed amount of active loans in kobo
  pendingWithdrawals  Int      // count of pending withdrawal requests
  pendingWithdrawalTotal Int   // total pending withdrawal amount in kobo
  createdAt           DateTime @default(now())

  @@index([cooperativeId, createdAt])
}

// ---- Statutory reserve fund allocations ----
// Nigerian cooperative law requires 20% of net profit be allocated to a
// statutory reserve fund before dividends are distributed to members.
model ReserveAllocation {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  amount        Int         // amount allocated to reserve in kobo
  source        String      // dividend_declaration | profit_sharing | manual
  referenceId   String?     // e.g., dividend batch ID
  note          String?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, createdAt])
}

// ---- Education Fund ----
model EducationFund {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  amount        Int         // amount allocated in kobo
  source        String      // dividend_declaration | manual
  referenceId   String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, createdAt])
}

// ---- Development Fund ----
model DevelopmentFund {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  amount        Int         // amount allocated in kobo
  source        String      // dividend_declaration | manual
  referenceId   String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, createdAt])
}

// ---- Members (users) ----
model Member {
  id                      String              @id @default(cuid())
  code                    String              @unique // short human-friendly code (e.g. A1B2C3) for guarantor/reference
  phone                   String // channel id: WhatsApp E.164 number, or "tg:<chatId>" for Telegram
  contactPhone            String? // real phone number (E.164) used for top-ups, payouts, KYC
  email                   String? // optional — statements can be sent here
  dateOfBirth             DateTime? // optional — used for birthday greetings (month/day only)
  nextOfKinName           String? // required for death claims
  nextOfKinPhone          String?
  phoneVerified           Boolean             @default(false) // OTP-verified real phone number
  name                    String
  bvn                     String?
  role                    String              @default("member") // member | admin | superadmin
  state                   String? // member's home state/LGA grouping
  lga                     String?
  pin                     String? // 4-digit transaction PIN (hashed)
  pinFailedCount          Int             @default(0) // consecutive wrong PIN attempts
  pinLockedUntil          DateTime? // brute-force lockout window
  totpSecret              String? // base32 TOTP secret — when set, money-out commands need a live 6-digit code
  status                  String              @default("active") // pending | active | suspended | deceased
  optedOut                Boolean             @default(false) // true = member opted out of all outbound messages
  bankAccountNumber       String? // member's bank account for withdrawals
  bankCode                String?
  bankName                String?
  lastWithdrawalAt        DateTime? // when the member last withdrew (6-month rule)
  withdrawalOverride      Boolean @default(false) // admin granted an early-withdrawal override
  frozenAt                DateTime? // when the member self-froze their wallet (money-out blocked); null = not frozen
  altChannelId            String? // linked second chat identity (other platform) — alerts only
  preferredChannel        String? // whatsapp | telegram — most-used platform, auto-learned
  lastStatementSentAt     DateTime? // month marker for monthly statements
  lastBirthdayGreetedYear Int? // year marker so birthdays only fire once a year
  lastAnniversaryGreetedYear Int? // year marker so anniversary greetings only fire once a year
  virtualAccountNumber    String? // provider-issued account number for top-ups
  virtualAccountBank      String?
  virtualAccountProvider  String?
  unitId                  String?
  unit                    Unit?               @relation("UnitMembership", fields: [unitId], references: [id], onDelete: SetNull)
  adminOf                 Unit[]              @relation("UnitAdmin")
  autoSaveAmount          Int? // recurring contribution amount in kobo
  autoSaveInterval        String? // weekly | monthly
  autoSaveNextDue         DateTime? // when the next reminder should fire
  autoSaveEnabled         Boolean             @default(false)
  cooperativeId           String
  cooperative             Cooperative         @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  progress                MemberProgress?
  consentAt               DateTime?           // when the member opted in to messages
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  wallet                  Wallet?
  contributions           Contribution[]
  loans                   Loan[]
  payouts                 Payout[]
  guarantorFor            Guarantor[]
  dividendEntries         DividendEntry[]
  withdrawalRequests      WithdrawalRequest[]
  deathClaims             DeathClaim[]
  deathValidations        DeathValidation[]
  ticketsOpened           SupportTicket[]     @relation("TicketMember")
  ticketsAssigned         SupportTicket[]     @relation("TicketAssignee")
  voteCandidates          VoteCandidate[]     @relation("VoteCandidates")
  voteBallots             VoteBallot[]        @relation("VoteBallots")
  salaryAmount            Int? // monthly salary/stipend for super admins in kobo (0 = off)
  salaryKind              String? // salary | stipend
  externalPaymentsInitiated ExternalPayment[] @relation("ExternalPayInitiator")
  externalPaymentsApproved1 ExternalPayment[] @relation("ExternalPayApprover1")
  externalPaymentsApproved2 ExternalPayment[] @relation("ExternalPayApprover2")
  externalPaymentsApproved3 ExternalPayment[] @relation("ExternalPayApprover3")
  loanSuperApproved2      Loan[]              @relation("LoanSuper2")
  pollOptionsCreated      PollOption[]        @relation("PollOptionCreator")
  purchasePollsCreated    PurchasePoll[]      @relation("PollCreator")
  pollBallots             PollBallot[]        @relation("PollVoter")
  guarantorDeductions     GuarantorDeduction[]
  beneficiaries           Beneficiary[]
  postsHeld               CoopPost[]          @relation("PostIncumbent")
  monthlyDeduction        Int? // agreed salary deduction remitted by employer in kobo
  deductionItems          DeductionItem[]
  deathClaimApprovals     DeathClaimApproval[] @relation("DeathClaimApprovals")
  grievances              Grievance[]
  grievancesResolved      Grievance[]         @relation("GrievanceResolver")
  strs                    STR[]
  deductionWaivers        DeductionWaiver[]
  batchesCreated          DeductionBatch[]    @relation("DeductionBatchCreator")
  batchesApproved         DeductionBatch[]    @relation("DeductionBatchApprover")
  favoritePayees          FavoritePayee[]
  dividendVotesOpened     DividendVote[]      @relation("DividendVoteOpener")
  dividendVoteBallots     DividendVoteBallot[] @relation("DividendVoteVoter")
  dataConsents            DataConsent[]
  dataConsentGiven        Boolean             @default(false)
  payeRecords             PAYERecord[]

  @@unique([cooperativeId, phone])
  @@index([phone])
  @@index([cooperativeId, role])
  @@index([status])
}

// ---- Units / workplaces ----
// Members of a cooperative are grouped into workplaces ("units"). Each unit
// has its own code and an assigned admin. Cooperative rules (savings, loans,
// guarantors, dividends) still apply across the whole cooperative.
model Unit {
  id            String      @id @default(cuid())
  name          String
  code          String // e.g. LAG01 — used to join the unit
  adminMemberId String?
  adminMember   Member?     @relation("UnitAdmin", fields: [adminMemberId], references: [id], onDelete: SetNull)
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  members       Member[]    @relation("UnitMembership")
  broadcasts    Broadcast[]
  createdAt     DateTime    @default(now())

  @@unique([cooperativeId, code])
}

model Wallet {
  id         String   @id @default(cuid())
  balance    Int      @default(0) // stored in kobo (₦1 = 100 kobo) — prevents float rounding
  totalSaved Int      @default(0) // stored in kobo
  memberId   String   @unique
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---- Savings / contributions ----
model Contribution {
  id            String      @id @default(cuid())
  amount        Int // stored in kobo (₦1 = 100 kobo)
  type          String      @default("savings") // savings | weekly | monthly | emergency
  note          String?
  reference     String      @unique // merchant ref for reconciliation
  status        String      @default("pending") // pending | confirmed | failed
  paidAt        DateTime?
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([memberId, status])
  @@index([cooperativeId, createdAt])
}

// ---- Loans ----
model Loan {
  id                 String          @id @default(cuid())
  amount             Int // stored in kobo
  interestRate       Float           @default(0) // monthly % (percentage, not money)
  tenureMonths       Int             @default(1)
  status             String          @default("pending") // pending | guaranteed | approved | disbursed | rejected | paid
  balance            Int // stored in kobo
  monthlyPayment     Int? // installment amount in kobo
  bankAccountNumber  String? // member's bank account for disbursement
  bankCode           String? // provider bank code
  bankName           String? // bank display name
  disbursementStatus String? // pending | successful | failed | name_mismatch
  disbursementError  String? // provider error or name-mismatch detail
  adminCharge        Int   @default(200000) // flat admin charge in kobo (₦2,000)
  disbursementAmount Int? // amount actually sent in kobo = amount - adminCharge
  adminApprovedById  String? // who gave the first (admin) approval
  finalApprovedById  String? // first super admin approval
  superApproved2ById String? // second super admin approval — triggers disbursement
  disbursedAt        DateTime?
  dueDate            DateTime? // next installment due date
  queuePosition      Int? // position in the loan approval queue
  queueJoinedAt      DateTime? // when the member joined the queue
  memberId           String
  member             Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  superApprover2     Member?         @relation("LoanSuper2", fields: [superApproved2ById], references: [id], onDelete: SetNull)
  cooperativeId      String
  cooperative        Cooperative     @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  approvedAt         DateTime?
  guarantors         Guarantor[]
  repayments         LoanRepayment[]

  @@index([memberId, status])
  @@index([cooperativeId, status])
  @@index([status, createdAt])
}

// ---- Guarantors ----
// A loan requires 2 guarantors. Each guarantor is a member, and the system
// generates a unique confirmation code for each before the loan can be approved.
model Guarantor {
  id          String    @id @default(cuid())
  loanId      String
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  code        String    @unique // auto-generated unique confirmation code
  status      String    @default("pending") // pending | confirmed | declined
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([loanId, memberId])
  @@index([code])
  @@index([memberId, status])
}

model LoanRepayment {
  id     String   @id @default(cuid())
  amount Int // stored in kobo
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paidAt DateTime @default(now())

  @@index([loanId, paidAt])
}

// ---- Payouts (admin disbursements to members) ----
model Payout {
  id            String      @id @default(cuid())
  amount        Int // stored in kobo
  reference     String      @unique
  // Deterministic per-logical-operation key so provider retries never
  // double-pay: e.g. TFR-LOAN-<loanId>. Unique => second create is rejected.
  idempotencyKey String?    @unique
  status        String      @default("pending") // pending | processing | successful | failed
  provider      String? // monnify | paystack | flutterwave
  providerRef   String? // provider-side reference/id
  note          String?
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id])
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

// ---- Provider webhook events (idempotency & duplicate protection) ----
// Every signed webhook delivery is recorded BEFORE processing. The composite
// event id is globally unique, so replays/retries hit the primary key and are
// acknowledged without reprocessing (permanent anti-replay window).
model WebhookEvent {
  id          String    @id // `${provider}:${eventTransactionId}`
  provider    String
  kind        String? // credit | payout_update
  payloadHash String
  status      String    @default("received") // received | processed | failed
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, receivedAt])
}

// ---- Double-entry journal (accounting source of truth) ----
model JournalEntry {
  id            String    @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  // Idempotency key: the same business event can never post twice.
  txRef         String    @unique
  description   String
  createdAt     DateTime  @default(now())
  postings      Posting[]
}

model Posting {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   String // assets:bank | income:<cat> | expense:<cat> | member_wallet:<walletId>
  direction String // DEBIT | CREDIT
  amount    Int // stored in kobo
  memberId  String?

  @@index([account])
}

// ---- Withdrawal requests (money out of a member's wallet) ----
// A member can withdraw at most once every 6 months (admin can override).
// Every withdrawal needs an admin approval, then the super admin's final
// approval, before the money is sent to the member's bank account.
model WithdrawalRequest {
  id                String      @id @default(cuid())
  amount            Int // stored in kobo
  status            String      @default("pending") // pending | admin_approved | paid | rejected
  bankAccountNumber String
  bankCode          String
  bankName          String?
  payoutReference   String?
  adminApprovedAt   DateTime?
  adminApprovedById String? // who gave the first (admin) approval
  finalizedAt       DateTime?
  finalizedById     String? // super admin who released the money
  rejectedAt        DateTime?
  memberId          String
  member            Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  cooperativeId     String
  cooperative       Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())

  @@index([memberId, status])
  @@index([cooperativeId, status])
  @@index([status, createdAt])
}

// ---- Death claims ----
// If the account holder dies, the family can withdraw the money. An admin
// records the claim with a death certificate, 2 guarantors validate it, and
// the super admin's final approval triggers the payout to the family's bank.
// ---- Beneficiaries (new-payee 24h cooling period) ----
// First time a bank account is paid by a cooperative it enters a holding
// window — account-takeover fraud usually wants SAME-DAY money movement.
model Beneficiary {
  id            String   @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  memberId      String? // null = external pay-anyone beneficiary
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  accountNumber String
  bankCode      String
  bankName      String?
  createdAt     DateTime @default(now()) // hold window starts here

  @@unique([cooperativeId, accountNumber, bankCode])
  @@index([cooperativeId, accountNumber])
}

model FavoritePayee {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name          String   // user-defined label, e.g. "Mama Ngozi"
  accountNumber String
  bankCode      String
  bankName      String?
  lastUsedAt    DateTime?
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([memberId, name])
  @@index([memberId])
}

// ---- Financial literacy progress ----
model MemberProgress {
  id              String   @id @default(cuid())
  memberId        String   @unique
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentLesson   Int      @default(1)
  completedLessons String  @default("[]")
  enrolledAt      DateTime @default(now())
  completedAt     DateTime?
  lastLessonAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([memberId])
}

// ---- Auto status posts ----
model StatusPost {
  id              String   @id @default(cuid())
  cooperativeId   String
  cooperative     Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  content         String
  scheduledTime   DateTime
  postedAt        DateTime?
  createdAt       DateTime @default(now())

  @@index([cooperativeId])
  @@index([scheduledTime])
}

model DeathClaim {
  id                  String            @id @default(cuid())
  memberId            String // the deceased member
  member              Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  cooperativeId       String
  cooperative         Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  status              String            @default("awaiting_certificate") // awaiting_certificate | awaiting_validation | validated | approved | paid | rejected
  certificateRef      String? // death certificate upload reference
  familyAccountNumber String?
  familyBankCode      String?
  familyBankName      String?
  familyPhone         String? // phone of the family member who must confirm
  familyConfirmed     Boolean           @default(false) // true once family confirms the claim
  familyConfirmedAt   DateTime? // when the family confirmed
  familyConfirmCode   String? // hashed OTP code sent to family for confirmation
  approvalsRequired   Int               @default(2) // number of super admin approvals needed
  approvalCount       Int               @default(0) // current number of approvals received
  waitingPeriodEnd    DateTime? // earliest time the claim can be finalized (72h after initiation)
  payoutReference     String?
  createdById         String?
  approvedAt          DateTime?
  finalizedAt         DateTime?
  createdAt           DateTime          @default(now())
  validations         DeathValidation[]
  approvals            DeathClaimApproval[]

  @@index([memberId, status])
  @@index([cooperativeId, status])
}

model DeathValidation {
  id        String     @id @default(cuid())
  claimId   String
  claim     DeathClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([claimId, memberId])
}

// ---- Audit log (who did what — every money/admin action) ----
// Entries are hash-chained: each entry stores the hash of the previous one,
// so tampering with history is detectable.
model AuditLog {
  id            String   @id @default(cuid())
  cooperativeId String
  actorId       String? // member who performed the action
  actorPhone    String
  actorRole     String? // member | admin | superadmin at the time
  action        String // e.g. loan.approve, withdraw.finalize, claim.payout, role.set
  targetType    String? // loan | withdrawal | deathclaim | member | ...
  targetId      String?
  amount        Int? // transaction amount in kobo (financial audit)
  balanceBefore Int? // wallet balance before the operation in kobo
  balanceAfter  Int? // wallet balance after the operation in kobo
  detail        String? // human-readable summary
  prevHash      String? // hash of the previous entry (tamper-evident chain)
  hash          String? // sha256 of this entry's content + prevHash
  createdAt     DateTime @default(now())

  @@index([cooperativeId, createdAt])
  @@index([action])
}

// ---- Ledger (profit & loss) ----
// Every income and expense the cooperative makes, so P&L is computable from
// transaction records. type: income | expense | appropriation (dividends).
model LedgerEntry {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  type          String // income | expense | appropriation
  category      String // interest | fine | admin_charge | salary | stipend | purchase | external_payment | dividend
  amount        Int // stored in kobo
  note          String?
  reference     String? // link to the source record (loan id, payout ref, ...)
  fundType      String      @default("operational") // member | operational | reserve
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, createdAt])
  @@index([cooperativeId, fundType])
}

// ---- Pay anyone (external disbursement, 3-super-admin rule) ----
model ExternalPayment {
  id                String      @id @default(cuid())
  cooperativeId     String
  cooperative       Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  beneficiaryName   String
  bankAccountNumber String
  bankCode          String
  bankName          String?
  amount            Int // stored in kobo
  purpose           String?
  status            String      @default("pending") // pending | approved1 | approved2 | paid | rejected | failed
  initiatedById     String
  initiator         Member      @relation("ExternalPayInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  approved1ById     String?
  approver1         Member?     @relation("ExternalPayApprover1", fields: [approved1ById], references: [id], onDelete: SetNull)
  approved2ById     String?
  approver2         Member?     @relation("ExternalPayApprover2", fields: [approved2ById], references: [id], onDelete: SetNull)
  approved3ById     String?
  approver3         Member?     @relation("ExternalPayApprover3", fields: [approved3ById], references: [id], onDelete: SetNull)
  lastApprovedAt    DateTime? // cool-off clock between approvals
  payoutReference   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([cooperativeId, status])
  @@index([initiatedById, status])
}

// ---- Buy votes (what should the coop buy for members?) ----
model PurchasePoll {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  title         String
  status        String      @default("open") // open | closed
  winnerOptionId String?
  createdById   String
  creator       Member      @relation("PollCreator", fields: [createdById], references: [id])
  options       PollOption[]
  ballots       PollBallot[]
  createdAt     DateTime    @default(now())
  closedAt      DateTime?

  @@index([cooperativeId, status])
}

model PollOption {
  id                String       @id @default(cuid())
  pollId            String
  poll              PurchasePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name              String // e.g. "Industrial generator"
  estimatedCost     Int // stored in kobo
  bankAccountNumber String? // vendor account for the auto pay-anyone request
  bankCode          String?
  bankName          String?
  createdById       String
  creator           Member       @relation("PollOptionCreator", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())

  ballots PollBallot[]
}

model PollBallot {
  id       String     @id @default(cuid())
  pollId   String
  poll     PurchasePoll @relation(fields: [pollId], references: [id])
  optionId String
  option   PollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterId  String
  voter    Member       @relation("PollVoter", fields: [voterId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, voterId]) // one person, one vote per poll
}

// ---- Guarantor default deductions ----
// When a borrower defaults for 2 straight months, each guarantor is notified
// that 50% of the loan's flat interest will be deducted from their savings
// in 10 days — unless the loan is brought current first.
model GuarantorDeduction {
  id            String    @id @default(cuid())
  cooperativeId String
  loanId        String
  guarantorId   String
  guarantor     Member    @relation(fields: [guarantorId], references: [id])
  amount        Int // stored in kobo (50% of the loan's flat interest)
  status        String    @default("notified") // notified | deducted | cancelled
  noticeSentAt  DateTime
  deductAt      DateTime // notice date + 10 days
  deductedAt    DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@unique([loanId, guarantorId])
  @@index([cooperativeId])
  @@index([status, deductAt])
}

// ---- Support tickets (customer service) ----
model SupportTicket {
  id            String   @id @default(cuid())
  cooperativeId String
  memberId      String
  message       String
  status        String   @default("open") // open | in_progress | resolved
  assignedToId  String? // customer-service/admin handling it
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member      Member      @relation("TicketMember", fields: [memberId], references: [id])
  assignedTo  Member?     @relation("TicketAssignee", fields: [assignedToId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])

  @@index([cooperativeId, status])
}

// ---- Voting engine (unit admin + executive elections) ----
model Vote {
  id            String    @id @default(cuid())
  cooperativeId String
  unitId        String? // null = cooperative-wide election
  kind          String // unit | exec — kept for backwards compat
  electionType  String    @default("general") // workplace | executive | general
  position      String? // e.g. "President", "Treasurer", "Lagos Admin"
  title         String
  status        String    @default("open") // open | closed
  winnerId      String? // member who won when closed
  createdById   String
  createdAt     DateTime  @default(now())
  closedAt      DateTime?
  quorumRequired Int     @default(30) // percentage of active members needed for quorum
  lastResultBroadcastAt DateTime? // last time live results were broadcast

  cooperative Cooperative     @relation(fields: [cooperativeId], references: [id])
  candidates  VoteCandidate[]
  ballots     VoteBallot[]

  @@index([cooperativeId, status])
}

model VoteCandidate {
  id       String @id @default(cuid())
  voteId   String
  memberId String

  vote    Vote         @relation(fields: [voteId], references: [id])
  member  Member       @relation("VoteCandidates", fields: [memberId], references: [id])
  ballots VoteBallot[]

  @@unique([voteId, memberId])
}

model VoteBallot {
  id          String   @id @default(cuid())
  voteId      String
  candidateId String
  voterId     String
  createdAt   DateTime @default(now())

  vote      Vote          @relation(fields: [voteId], references: [id])
  candidate VoteCandidate @relation(fields: [candidateId], references: [id])
  voter     Member        @relation("VoteBallots", fields: [voterId], references: [id])

  @@unique([voteId, voterId]) // one person, one vote per election
}

// ---- Dividend-rate member vote ----
// Cooperative governance: a proposed dividend rate that differs by more than
// the allowed threshold from last time must be approved by a member vote before
// the super admin may distribute it.
model DividendVote {
  id            String    @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  proposedRate  Int       // proposed dividend rate (%)
  status        String    @default("open") // open | approved | rejected | closed
  openedById    String
  openedBy      Member    @relation("DividendVoteOpener", fields: [openedById], references: [id])
  yesVotes      Int       @default(0)
  noVotes       Int       @default(0)
  requiredYesPct Int      @default(40) // % of active members that must vote YES to pass
  expiresAt     DateTime
  closedById    String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  ballots DividendVoteBallot[]

  @@index([cooperativeId, status])
}

model DividendVoteBallot {
  id        String       @id @default(cuid())
  voteId    String
  vote      DividendVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation("DividendVoteVoter", fields: [memberId], references: [id])
  choice    Boolean      // true = yes, false = no
  createdAt DateTime     @default(now())

  @@unique([voteId, memberId]) // one person, one vote per dividend-rate ballot
  @@index([memberId])
}

// ---- Dividends ----
// A dividend run: admin sets a rate and the pool is shared proportionally to
// each member's lifetime savings (totalSaved). `paydividend` credits wallets.
model Dividend {
  id            String          @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative     @relation(fields: [cooperativeId], references: [id])
  reference     String          @unique
  rate          Float // percentage of totalSaved (percentage, not money)
  totalPool     Int // stored in kobo
  status        String          @default("pending") // pending | distributed
  createdAt     DateTime        @default(now())
  distributedAt DateTime?
  entries       DividendEntry[]
}

model DividendEntry {
  id         String    @id @default(cuid())
  dividendId String
  dividend   Dividend  @relation(fields: [dividendId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Int // stored in kobo
  status     String    @default("pending") // pending | paid
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([dividendId, memberId])
}

// ---- Broadcasts (admin announcements) ----
model Broadcast {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  senderId      String
  senderName    String
  message       String
  scope         String      @default("coop") // coop | unit
  unitId        String? // set when scope = unit
  unit          Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
}

// ---- Chat state machine (multi-turn onboarding / flows) ----
model Session {
  id             String    @id @default(cuid())
  phone          String    @unique
  state          String    @default("idle") // idle | awaiting_name | awaiting_coop | awaiting_pin | ...
  data           String    @default("{}") // JSON payload for the current flow
  lastInboundAt  DateTime? // tracks WhatsApp 24-hour customer service window
  updatedAt      DateTime  @updatedAt

  @@index([updatedAt])
}

// ---- Executive posts (organogram) ----
model CoopPost {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  title         String // normalised lowercase key, e.g. "treasurer"
  incumbentId   String?
  incumbent     Member?     @relation("PostIncumbent", fields: [incumbentId], references: [id], onDelete: SetNull)
  appointedById String?
  appointedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cooperativeId, title])
}

// ---- Employer salary-deduction remittance ----
model DeductionBatch {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  ref           String      @unique
  status        String      @default("draft") // draft | submitted | approved | rejected
  totalAmount   Int         @default(0) // stored in kobo
  note          String?
  createdById   String
  createdBy     Member      @relation("DeductionBatchCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    Member?     @relation("DeductionBatchApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         DeductionItem[]

  @@index([cooperativeId])
}

model DeductionItem {
  id         String         @id @default(cuid())
  batchId    String
  batch      DeductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id])
  kind       String         @default("savings") // savings | loan
  loanId     String? // set when kind = loan
  amount     Int // stored in kobo
  status     String         @default("pending") // pending | credited
  creditedAt DateTime?

  @@unique([batchId, memberId, kind])
}

model DeductionWaiver {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period      String // "YYYY-MM"
  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([memberId, period])
}

// ---- Per-cooperative business rules (SaaS config) ----
model CooperativeConfig {
  id                       String   @id @default(cuid())
  cooperativeId            String   @unique
  cooperative              Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  loanInterestRate         Int      @default(10) // percentage
  serviceChargePercent     Int      @default(2) // percentage
  minContribution          Int      @default(200000) // kobo
  minSavings               Int      @default(100000) // kobo
  minWithdrawal            Int      @default(500000) // kobo
  maxWithdrawal            Int      @default(5000000) // kobo
  withdrawalCooldownMonths Int      @default(6)
  lateFinePercent          Int      @default(5) // percentage
  maxLoanMultiplier        Int      @default(3) // max loan = multiplier × savings
  autoApproveLoans         Boolean  @default(false)
  requireGuarantors        Boolean  @default(true)
  minGuarantors            Int      @default(2)
  statusEnabled            Boolean  @default(true) // per-coop toggle for auto status posts
  nextAGMDate              DateTime?
  lastDividendRate         Int?
  pendingDividendRate      Int?
  taxIdentificationNumber  String?
  cooperativeType          String   @default("member") // member | commercial
  commercialIncome         Int      @default(0) // kobo from non-member activities
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([cooperativeId])
}

// ---- Per-cooperative branding (SaaS config) ----
model BrandingConfig {
  id            String   @id @default(cuid())
  cooperativeId String   @unique
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  displayName   String
  welcomeMessage String?
  footerText    String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cooperativeId])
}

// ---- Per-cooperative subscription (SaaS billing) ----
model Subscription {
  id               String    @id @default(cuid())
  cooperativeId    String    @unique
  cooperative      Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  plan             String    @default("free") // free | starter | pro | enterprise
  status           String    @default("active") // active | suspended | past_due
  memberLimit      Int       @default(20)
  monthlyPrice     Int       @default(0) // kobo
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([cooperativeId])
}

// ---- NDPR data consent log ----
model DataConsent {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  consentType   String   // registration | delete_account | data_export
  granted       Boolean
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([memberId])
}

// ---- PAYE (Pay As You Earn) records for state IRS remittance ----
model PAYERecord {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id])
  month         Int // 1-12
  year          Int
  grossAmount   Int // kobo
  taxAmount     Int // kobo
  netAmount     Int // kobo
  status        String      @default("pending") // pending | remitted
  remittedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@unique([cooperativeId, memberId, month, year])
  @@index([cooperativeId, year, month])
}

model Byelaw {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  title         String
  content       String
  createdAt     DateTime    @default(now())

  @@index([cooperativeId])
}

model DeathClaimApproval {
  id              String      @id @default(cuid())
  deathClaimId    String
  deathClaim      DeathClaim  @relation(fields: [deathClaimId], references: [id], onDelete: Cascade)
  approvedById    String
  approvedBy      Member      @relation("DeathClaimApprovals", fields: [approvedById], references: [id])
  approvedAt      DateTime    @default(now())

  @@unique([deathClaimId, approvedById])
  @@index([deathClaimId])
}

model STR {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amount        Int
  reason        String
  status        String      @default("pending")
  filedAt       DateTime?
  createdAt     DateTime    @default(now())

  @@index([cooperativeId, createdAt])
  @@index([memberId, status])
}

model Grievance {
  id            String   @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  message       String
  status        String   @default("open")
  response      String?
  resolvedById  String?
  resolvedBy    Member?  @relation("GrievanceResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cooperativeId, status])
  @@index([memberId])
}
