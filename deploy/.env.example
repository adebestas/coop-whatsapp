# coop-whatsapp — server environment for the Docker Compose stack.
#
# Copy to `.env` in the repo root (deploy/bootstrap.sh does this for you and
# generates the four infra secrets), then fill in the provider values and
# `DOMAIN`, and run:
#
#   docker compose up -d --build
#
# This file is NOT read by the app during local development (that uses
# prisma/schema.local.prisma + SQLite) — it only feeds `docker compose`.

# ---- Public hostname ---------------------------------------------------------
# A hostname whose DNS A record points at this server. Caddy gets a free
# Let's Encrypt certificate for it and the WhatsApp webhook becomes
# https://<DOMAIN>/webhook
# Free option: a DuckDNS name, e.g. mycoop.duckdns.org
DOMAIN=

# ---- Infrastructure secrets (bootstrap.sh fills these in automatically) ------
POSTGRES_USER=coop
POSTGRES_DB=coop
POSTGRES_PASSWORD=
# Non-owner role the app connects as, so Postgres RLS is enforced. The owner
# credentials are used only for migrations (DATABASE_OWNER_URL).
COOP_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
ADMIN_JWT_SECRET=

# ---- WhatsApp Cloud API (required for the bot to start) ----------------------
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional WhatsApp Flow used for hidden PIN/OTP entry (flows/pin-flow.json)
WHATSAPP_PIN_FLOW_ID=
WHATSAPP_PIN_FLOW_MODE=published

# ---- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=monnify
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
PAYSTACK_SECRET_KEY=

# ---- Platform Console bootstrap ---------------------------------------------
# Phone (E.164, no +) of the first platform owner. On boot the app seeds ONE
# owner with this one-time 6-digit PIN. Change it at https://<DOMAIN>/dashboard/dev/,
# enable 2FA, then unset PLATFORM_OWNER_PIN.
PLATFORM_OWNER_PHONE=
# Optional display name for the seeded owner (defaults to "Platform Owner").
PLATFORM_OWNER_NAME=
# Preferred: the one-time 6-digit PIN (never logged or written to disk).
PLATFORM_OWNER_PIN=
# Alternative to PLATFORM_OWNER_PIN: a root-only file path for a generated PIN.
# Leave both empty to skip bootstrap — no PIN file is written by default.
PLATFORM_OWNER_PIN_FILE=

# ---- Backups -----------------------------------------------------------------
# Encrypts nightly Postgres dumps (AES-256-CBC, PBKDF2). Generated by bootstrap.sh.
# Without it the backup script warns; production refuses to write plaintext dumps.
BACKUP_ENCRYPTION_KEY=
# Set to 1 to refuse unencrypted dumps even outside NODE_ENV=production.
REQUIRE_ENCRYPTED_BACKUPS=

# App-side nightly backup job (src/services/backup.ts). In production this FAILS
# CLOSED unless off-instance storage is configured, because Render wipes the
# container disk on redeploy. Create an S3-compatible bucket (Backblaze B2,
# Cloudflare R2, AWS S3, ...) and set all three:
BACKUP_BUCKET=
BACKUP_KEY=
BACKUP_SECRET=
# Optional: custom endpoint for non-AWS providers, and region (default eu-west-1).
BACKUP_ENDPOINT=
BACKUP_REGION=
# Local-only backups in production are ephemeral. Set to 1 only to accept that
# risk for a short pilot; never for real member money.
BACKUP_ALLOW_LOCAL=

# ---- Optional integrations / tuning ------------------------------------------
# PUBLIC_BASE_URL defaults to https://<DOMAIN> when left blank.
PUBLIC_BASE_URL=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram chat id (user or group) that receives operational alerts from the
# uptime watchdog. Leave blank to log-only.
ALERT_TELEGRAM_CHAT_ID=
DEFAULT_COOP_CODE=
# Public origin of the admin/developer consoles (e.g. https://admin.example.com).
# Mutating console requests from any other Origin are rejected; same-host requests
# are always allowed, so this is only needed behind a custom domain or proxy.
DASHBOARD_ORIGIN=
CUBECOVER_API_KEY=
CUBECOVER_BASE_URL=https://api.cubecover.ai
CUBECOVER_WEBHOOK_SECRET=
ALLOWED_TEST_NUMBERS=
DIGEST_HOUR=20
TWO_FA_REQUIRED=1
NEW_BENEFICIARY_HOLD_HOURS=24
REPIN_THRESHOLD_NGN=50000
# Hard ceiling on total money-out per calendar month during a no-money pilot.
# Set to 0/blank to disable. Start at 500000 (₦5,000) and raise deliberately.
PILOT_FLOAT_CAP=500000
TRANSFER_POLL_MINUTES=10
