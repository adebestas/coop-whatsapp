# ---- App ----
PORT=3000
HOST=0.0.0.0
# production | development | test — gates several safety defaults (2FA, holds, caps)
NODE_ENV=production

# ---- Telegram Bot ----
# Create a bot with @BotFather and paste the token. The bot runs on the same
# commands as WhatsApp (join, save, loan, etc.). Long-polling is used, so no
# public URL or webhook is needed.
TELEGRAM_BOT_TOKEN=

# ---- WhatsApp Cloud API (Meta) ----
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_a_random_secret_string
# Comma-separated list of phone numbers allowed to talk to the bot during development.
# Leave empty to allow everyone.
ALLOWED_TEST_NUMBERS=

# ---- Prisma (SQLite dev) ----
# For production, switch to Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/coop?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Payments ----
# Primary provider is Monnify (virtual accounts + payouts).
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# sandbox | live
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Fallback providers:
PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=
PAYSTACK_TRANSFER_SOURCE=balance

# ---- Security hardening (pre-launch checklist) ----
# Require TOTP 2FA on every money-out admin command (1 = enforce). Enroll with *enable2fa*.
TWO_FA_REQUIRED=1
# Re-verify PIN before single payouts above this amount (NGN). 0 disables.
REPIN_THRESHOLD_NGN=50000
# Minutes a PIN verification stays "fresh" for large payouts.
FRESH_PIN_MINUTES=10
# First-time bank accounts cannot receive money for N hours (account-takeover brake). 0 disables.
NEW_BENEFICIARY_HOLD_HOURS=24
# Hard monthly ceiling on total money-out per cooperative (pilot safety cap). 0/unset disables.
PILOT_FLOAT_CAP=500000
# Hour of day (0-23) the daily movement digest goes to super admins.
DIGEST_HOUR=20
# Minutes between provider transfer-status polls that auto-settle/refund stuck payouts.
TRANSFER_POLL_MINUTES=10

# ---- Admin dashboard ----
# Secret used to sign admin dashboard login tokens. Generate: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-in-production
SESSION_SECRET=generate_a_long_random_string_min_32_chars

# ---- Default cooperative for onboarding in dev ----
# If set, users who don't have a cooperative yet can join this one with the join command.
DEFAULT_COOP_CODE=TEST01
